# ============================================================
# Environment / Secrets
# ============================================================

.env
.env.*
!.env.example

# Local configuration files containing company paths
config/config.py

# Allow the sanitized configuration template
!config/config.example.py


# ============================================================
# Excel / Office Files
# ============================================================

# Ignore real/company Excel files
*.xlsx
*.xls
*.xlsm
*.xlsb
*.csv

# Allow sanitized portfolio examples
!docs/examples/
!docs/examples/*.xlsx


